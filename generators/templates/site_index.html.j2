<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ team.name }} {{ team.number }} Skill Trees</title>
<style>
  body { font-family: -apple-system, "Helvetica Neue", Arial, sans-serif; margin: 0 auto; padding: 28px 16px; color: #1a1a1a; max-width: 900px; }
  h1 { font-size: clamp(28px, 5vw, 44px); margin: 12px 0 0; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 6px solid #84EC5C; display: inline-block; }
  img.logo { height: 38px; }
  .meta { color: #666; font-size: 13px; margin-bottom: 18px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; color: #111; border-bottom: 3px solid #111; padding-bottom: 3px; margin-top: 26px; }
  .cards { display: flex; flex-wrap: wrap; gap: 12px; }
  a.card { display: block; border: 3px solid #111; border-left: 8px solid #84EC5C; border-radius: 8px; padding: 12px 16px; text-decoration: none; color: #1a1a1a; flex: 1 1 240px; }
  a.card .name { font-weight: 800; font-size: 18px; color: #111; text-transform: uppercase; letter-spacing: 0.04em; }
  a.card .desc { font-size: 12px; color: #555; margin-top: 4px; }
  a.card.draft { border-style: dashed; border-color: #999; border-left: 8px solid #ccc; }
  a.card.draft .name { color: #666; }
  footer { margin-top: 30px; font-size: 11px; color: #999; }
</style>
</head>
<body>
  <img class="logo" src="assets/lockup-horizontal.svg" alt="Raptacon 3200"><br>
  <h1>{{ team.name }} {{ team.number }} Skill Trees</h1>
  <div class="meta">{{ season }} season</div>

  <h2>Start here</h2>
  <div class="cards">
    {% for t in trees %}
    <a class="card" href="{{ t.id }}.html"><div class="name">{{ t.name }}</div>{% if t.description %}<div class="desc">{{ t.description }}</div>{% endif %}</a>
    {% endfor %}
  </div>

  <h2>Subteam trees</h2>
  <div class="cards">
    {% for t in subteams %}
    <a class="card{% if t.draft %} draft{% endif %}" href="{{ t.id }}.html"><div class="name">{{ t.name }}</div>{% if t.draft %}<div class="desc">First draft</div>{% endif %}</a>
    {% endfor %}
    <a class="card draft" href="techmap.html"><div class="name">Tech map</div><div class="desc">Every tree on one page.</div></a>
  </div>

  <footer>Built from github.com/Raptacon/skill-tree. Want to add or fix a skill? Open a pull request.</footer>
</body>
</html>
