{% from "_theme.html.j2" import theme_toggle %}<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ team.name }} {{ team.number }} Skill Trees</title>
<style>
  body { font-family: -apple-system, "Helvetica Neue", Arial, sans-serif; margin: 0 auto; padding: 28px 16px; max-width: 900px; }
  h1 { font-size: clamp(28px, 5vw, 44px); margin: 12px 0 0; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 6px solid var(--green); display: inline-block; }
  img.logo { height: 38px; }
  .meta { color: var(--muted); font-size: 13px; margin-bottom: 18px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--fg-strong); border-bottom: 3px solid var(--fg-strong); padding-bottom: 3px; margin-top: 26px; }
  .cards { display: flex; flex-wrap: wrap; gap: 12px; }
  a.card { display: block; border: 3px solid var(--fg-strong); border-left: 8px solid var(--green); border-radius: 8px; padding: 12px 16px; text-decoration: none; color: var(--fg); flex: 1 1 240px; }
  a.card .name { font-weight: 800; font-size: 18px; color: var(--fg-strong); text-transform: uppercase; letter-spacing: 0.04em; }
  a.card .desc { font-size: 12px; color: var(--muted); margin-top: 4px; }
  a.signoff { display: flex; gap: 16px; align-items: center; margin: 12px 0; padding: 14px 18px; border-radius: 12px; border: 3px solid var(--ok); background: var(--ok-bg); color: var(--fg-strong); text-decoration: none; }
  a.signoff img { width: 120px; height: 120px; flex: none; }
  a.signoff .name { font-size: 20px; font-weight: 800; color: var(--ok); }
  a.signoff .desc { font-size: 15px; color: var(--text2); margin-top: 4px; }
  a.hero { display: block; margin: 18px 0 6px; padding: 18px 20px; border-radius: 12px; background: var(--block); color: var(--on-block); text-decoration: none; }
  a.hero .name { font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--green); }
  a.hero .desc { font-size: 15px; color: var(--on-block-muted); margin-top: 4px; }
  a.card.draft { border-style: dashed; border-color: var(--faint); border-left: 8px solid var(--line-strong); }
  a.card.draft .name { color: var(--muted); }
  footer { margin-top: 30px; font-size: 11px; color: var(--faint); }
</style>
{% include "_theme.html.j2" %}
</head>
<body>
{{ theme_toggle() }}
  <img class="logo logo-l" src="assets/lockup-horizontal.svg" alt="Raptacon 3200"><img class="logo logo-d" src="assets/lockup-horizontal-dark.svg" alt="Raptacon 3200"><br>
  <h1>{{ team.name }} {{ team.number }} Skill Trees</h1>
  <div class="meta">{{ season }} season</div>

  <a class="hero" href="path.html">
    <div class="name">Your path</div>
    <div class="desc">Not sure what's next? Follow the trail, one stop at a time - Baseline, Core Knowledge, then your subteam.</div>
  </a>
  <a class="hero" href="techmap.html">
    <div class="name">The Tech Map</div>
    <div class="desc">Every tree and every tier on one page - from your first day to Master, and the hybrids in between.</div>
  </a>

  {% if signoff_url %}
  <a class="signoff" href="{{ signoff_url }}">
    <img src="{{ signoff_qr }}" alt="QR code to the sign-off form">
    <div><div class="name">&#9989; Leads &amp; mentors: sign off a skill</div>
    <div class="desc">Watched someone pass a skill's test? Scan or click to record it - on your phone, in about 15 seconds. Use the email or School ID you check in with.</div></div>
  </a>
  {% endif %}

  <div class="cards side">
    <a class="card" href="bash/"><div class="name">&#128058; Command-line game</div><div class="desc">Bibbidi-Bobbidi-Bash: learn the terminal, Git, PowerShell and more by playing.</div></a>
    {% for s in slides %}<a class="card" href="{{ s.id }}_slide.html"><div class="name">&#128250; {{ s.name }} slide</div><div class="desc">For meetings and join nights.</div></a>{% endfor %}
  </div>

  <h2>Start here</h2>
  <div class="cards">
    {% for t in trees %}
    <a class="card" href="{{ t.id }}.html"><div class="name">{{ t.name }}</div>{% if t.description %}<div class="desc">{{ t.description }}</div>{% endif %}</a>
    {% endfor %}
  </div>

  {% if quizzes %}
  <h2 id="quizzes">Safety quizzes</h2>
  <div class="cards">
    {% for q in quizzes %}
    <a class="card" href="quiz-{{ q.id }}.html"><div class="name">&#128221; {{ q.name | replace(' safety quiz', '') | replace(' quiz', '') }}</div><div class="desc">{{ q.count }} questions. Pass at 100%, then a mentor signs you off.</div></a>
    {% endfor %}
  </div>

  {% endif %}
  <h2>Subteam trees</h2>
  <div class="cards">
    {% for t in subteams %}
    <a class="card" href="{{ t.id }}.html"><div class="name">{{ t.name }}</div></a>
    {% endfor %}
  </div>

  {% if specializations %}
  <h2>Specializations</h2>
  <div class="cards">
    {% for t in specializations %}
    <a class="card" href="{{ t.id }}.html"><div class="name">{{ t.name }}</div>{% if t.description %}<div class="desc">{{ t.description }}</div>{% endif %}</a>
    {% endfor %}
  </div>
  {% endif %}

  <footer>Built from github.com/Raptacon/skill-tree. Want to add or fix a skill? Open a pull request.</footer>
</body>
</html>
