<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ tree.name }} - {{ team.name }} {{ team.number }}</title>
<style>
  body { font-family: -apple-system, "Helvetica Neue", Arial, sans-serif; margin: 0; padding: 28px; color: #1a1a1a; }
  h1 { font-size: 28px; margin: 0; }
  .meta { color: #666; font-size: 13px; margin-bottom: 12px; }
  .intro { font-size: 14px; max-width: 40em; margin-bottom: 18px; }
  .roles { display: flex; flex-wrap: wrap; gap: 12px; }
  .role {
    display: block;
    border: 2px solid #1a6fb0;
    border-radius: 8px;
    padding: 14px 18px;
    min-width: 10em;
    text-decoration: none;
    color: #1a1a1a;
  }
  .role .name { font-weight: 700; font-size: 16px; color: #1a6fb0; }
  .role .count { font-size: 12px; color: #666; }
  .hint { font-size: 12px; color: #777; margin-top: 18px; }
</style>
</head>
<body>
  <h1>{{ tree.name }}</h1>
  <div class="meta">{{ team.name }} {{ team.number }} &middot; {{ season }} season</div>
  {% if tree.description %}<div class="intro">{{ tree.description }}</div>{% endif %}
  <div class="roles">
    {% for p in pages %}
    <a class="role" href="{{ p.file }}"><div class="name">{{ p.role }}</div><div class="count">{{ p.count }} item{{ 's' if p.count != 1 }}</div></a>
    {% endfor %}
  </div>
  <div class="hint">More than one role (e.g. parent and mentor)? Do every item on each of your pages - shared items only need doing once.</div>
</body>
</html>
